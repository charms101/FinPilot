{
  "name": "finpilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start": "npm run preview:static",
    "lint": "eslint",
    "acceptance:static": "node scripts/acceptance-static.mjs",
    "preview:static": "python3 -m http.server 4173 --directory out",
    "smoke": "tsc scripts/smoke-calculations.ts src/lib/calculations.ts src/lib/playbook.ts src/lib/profile.ts --outDir /tmp/finpilot-smoke --module commonjs --target ES2022 --skipLibCheck --esModuleInterop --moduleResolution node --noEmit false && node /tmp/finpilot-smoke/scripts/smoke-calculations.js"
  },
  "dependencies": {
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
